generator client {
  provider = "prisma-client"
  output   = "../prisma/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum EmployeeStatus {
  ACTIVE
  PROBATION
  INACTIVE
}

enum ContractType {
  PERMANENT
  CONTRACT
  INTERNSHIP
}

enum DocumentType {
  KTP
  NPWP
  DIPLOMA
  CONTRACT
  OTHER
}

enum ChangeRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AttendanceRecordStatus {
  OPEN
  CLOSED
}

enum LeaveRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum LeaveApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum NotificationEmailStatus {
  PENDING
  SENT
  SKIPPED
  FAILED
}

enum PtkpStatus {
  TK_0
  TK_1
  TK_2
  TK_3
  K_0
  K_1
  K_2
  K_3
}

enum TaxMethod {
  GROSS
  GROSS_UP
  NETT
}

enum SalaryComponentKind {
  BASIC
  ALLOWANCE_FIXED
  ALLOWANCE_VARIABLE
  DEDUCTION
}

enum PayrollPeriodType {
  MONTHLY
  SEMI_MONTHLY
  WEEKLY
}

enum PayrollRunStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum PayrollExportKind {
  ACCOUNTING
  PPH21_MONTHLY
  PPH21_1721_A1
  BANK_TRANSFER
}

enum JobPostingStatus {
  DRAFT
  OPEN
  CLOSED
}

enum ApplicationStatus {
  ACTIVE
  HIRED
  REJECTED
  WITHDRAWN
}

enum OnboardingAssigneeKind {
  NEW_HIRE
  HR
  MANAGER
  IT
  FINANCE
}

enum OnboardingProcessStatus {
  IN_PROGRESS
  COMPLETED
}

enum GoalLevel {
  COMPANY
  DEPARTMENT
  EMPLOYEE
}

enum GoalStatus {
  DRAFT
  PENDING_APPROVAL
  ACTIVE
  REJECTED
  COMPLETED
  CANCELLED
}

enum PerformancePeriodType {
  MONTHLY
  QUARTERLY
  YEARLY
}

enum PerformanceCycleStatus {
  DRAFT
  OPEN
  LOCKED
}

enum PerformanceReviewStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

enum PerformanceRaterType {
  SELF
  MANAGER
  PEER
}

enum PerformanceRecommendation {
  PROMOTION
  DEVELOPMENT
  PIP
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  employeeId   String   @unique
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  employee                  Employee                 @relation(fields: [employeeId], references: [id])
  roles                     UserRole[]
  refreshTokens             RefreshToken[]
  auditLogs                 AuditLog[]
  createdDocuments          EmployeeDocument[]
  mutationsCreated          EmployeeMutation[]
  changeRequestsReviewed    EmployeeChangeRequest[]  @relation("ChangeRequestReviewer")
  notifications             Notification[]
  leaveAttachments          LeaveAttachment[]
  payrollRunsTriggered      PayrollRun[]
  jobPostingsCreated        JobPosting[]
  applicationNotes          ApplicationNote[]
  applicationAttachments    ApplicationAttachment[]
  goalsCreated              Goal[]

  @@index([email])
  @@map("users")
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  permissions RolePermission[]
  users       UserRole[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(cuid())
  key         String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId String
  roleId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model RefreshToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model Department {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  parentId  String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parent        Department?         @relation("DepartmentTree", fields: [parentId], references: [id])
  children      Department[]        @relation("DepartmentTree")
  positions     Position[]
  employees     Employee[]
  mutationsFrom EmployeeMutation[]  @relation("MutationFromDept")
  mutationsTo   EmployeeMutation[]  @relation("MutationToDept")
  leavePolicies LeavePolicy[]
  jobPostings   JobPosting[]
  goals         Goal[]

  @@index([parentId])
  @@map("departments")
}

model Position {
  id           String   @id @default(cuid())
  name         String
  code         String   @unique
  parentId     String?
  departmentId String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  parent        Position?           @relation("PositionTree", fields: [parentId], references: [id])
  children      Position[]          @relation("PositionTree")
  department    Department?         @relation(fields: [departmentId], references: [id])
  employees     Employee[]
  mutationsFrom EmployeeMutation[]  @relation("MutationFromPos")
  mutationsTo   EmployeeMutation[]  @relation("MutationToPos")
  leavePolicies         LeavePolicy[]
  jobPostings           JobPosting[]
  onboardingTemplates   OnboardingTemplate[]

  @@index([parentId])
  @@index([departmentId])
  @@map("positions")
}

model Employee {
  id               String         @id @default(cuid())
  fullName         String
  nationalId       String         @unique
  birthDate        DateTime       @db.Date
  address          String
  phone            String
  emergencyContact String
  employeeNumber   String         @unique
  departmentId     String
  positionId       String
  managerId        String?
  joinedAt         DateTime       @db.Date
  status           EmployeeStatus
  contractType     ContractType
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  department     Department              @relation(fields: [departmentId], references: [id])
  position       Position                @relation(fields: [positionId], references: [id])
  manager        Employee?               @relation("EmployeeManager", fields: [managerId], references: [id])
  reports        Employee[]              @relation("EmployeeManager")
  user              User?
  mutations         EmployeeMutation[]
  documents         EmployeeDocument[]
  changeRequests    EmployeeChangeRequest[]
  shiftAssignments  ShiftAssignment[]
  attendanceRecords AttendanceRecord[]
  leaveBalances     LeaveBalance[]
  leaveRequests     LeaveRequest[]
  leaveApprovals    LeaveApproval[]
  payrollProfile    EmployeePayrollProfile?
  salaryAssignments EmployeeSalaryAssignment[]
  payslips          Payslip[]
  hiredApplications Application[]
  onboardingProcess OnboardingProcess?
  onboardingTasks   OnboardingTask[]   @relation("OnboardingAssignee")
  goals             Goal[]
  performanceReviews PerformanceReview[]
  performanceRatings PerformanceRating[]
  performancePeerOf  PerformancePeerAssignment[]

  @@index([departmentId])
  @@index([positionId])
  @@index([managerId])
  @@index([status])
  @@map("employees")
}

model EmployeeMutation {
  id               String   @id @default(cuid())
  employeeId       String
  fromDepartmentId String
  toDepartmentId   String
  fromPositionId   String
  toPositionId     String
  effectiveAt      DateTime
  reason           String
  createdByUserId  String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  employee       Employee   @relation(fields: [employeeId], references: [id])
  fromDepartment Department @relation("MutationFromDept", fields: [fromDepartmentId], references: [id])
  toDepartment   Department @relation("MutationToDept", fields: [toDepartmentId], references: [id])
  fromPosition   Position   @relation("MutationFromPos", fields: [fromPositionId], references: [id])
  toPosition     Position   @relation("MutationToPos", fields: [toPositionId], references: [id])
  createdBy      User       @relation(fields: [createdByUserId], references: [id])

  @@index([employeeId])
  @@map("employee_mutations")
}

model EmployeeDocument {
  id               String       @id @default(cuid())
  employeeId       String
  type             DocumentType
  fileName         String
  contentType      String
  sizeBytes        Int
  objectKey        String
  uploadedByUserId String
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  employee   Employee @relation(fields: [employeeId], references: [id])
  uploadedBy User     @relation(fields: [uploadedByUserId], references: [id])

  @@index([employeeId])
  @@map("employee_documents")
}

model EmployeeChangeRequest {
  id             String              @id @default(cuid())
  employeeId     String
  payload        Json
  status         ChangeRequestStatus @default(PENDING)
  reviewerUserId String?
  reviewNote     String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id])
  reviewer User?    @relation("ChangeRequestReviewer", fields: [reviewerUserId], references: [id])

  @@index([employeeId])
  @@index([status])
  @@map("employee_change_requests")
}

model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String
  entityType  String
  entityId    String
  action      String
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  actor User @relation(fields: [actorUserId], references: [id])

  @@index([entityType, entityId])
  @@index([actorUserId])
  @@map("audit_logs")
}

model Shift {
  id                 String   @id @default(cuid())
  name               String
  code               String   @unique
  startMinutes       Int
  endMinutes         Int
  graceMinutesLate     Int      @default(0)
  graceMinutesEarly    Int      @default(0)
  overtimeCapMinutes   Int      @default(0)
  isFlexible           Boolean  @default(false)
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  assignments ShiftAssignment[]
  records     AttendanceRecord[]

  @@map("shifts")
}

model ShiftAssignment {
  id            String    @id @default(cuid())
  employeeId    String
  shiftId       String
  effectiveFrom DateTime  @db.Date
  effectiveTo   DateTime? @db.Date
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id])
  shift    Shift    @relation(fields: [shiftId], references: [id])

  @@index([employeeId, effectiveFrom])
  @@index([shiftId])
  @@map("shift_assignments")
}

model AttendanceRecord {
  id                String                 @id @default(cuid())
  employeeId        String
  shiftId           String
  workDate          DateTime               @db.Date
  checkedInAt       DateTime
  checkedOutAt      DateTime?
  workedMinutes     Int?
  lateMinutes       Int                    @default(0)
  earlyLeaveMinutes Int                    @default(0)
  overtimeMinutes   Int                    @default(0)
  status            AttendanceRecordStatus @default(OPEN)
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id])
  shift    Shift    @relation(fields: [shiftId], references: [id])

  @@unique([employeeId, workDate])
  @@index([workDate, status])
  @@index([shiftId])
  @@map("attendance_records")
}

model LeaveType {
  id                  String   @id @default(cuid())
  code                String   @unique
  name                String
  requiresBalance     Boolean  @default(true)
  requiresAttachment  Boolean  @default(false)
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  policies  LeavePolicy[]
  balances  LeaveBalance[]
  requests  LeaveRequest[]

  @@map("leave_types")
}

model LeavePolicy {
  id                  String   @id @default(cuid())
  leaveTypeId         String
  departmentId        String?
  positionId          String?
  annualAllowanceDays Int
  approvalLevelCount  Int      @default(2)
  accrualPerMonth     Int      @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  leaveType  LeaveType   @relation(fields: [leaveTypeId], references: [id])
  department Department? @relation(fields: [departmentId], references: [id])
  position   Position?   @relation(fields: [positionId], references: [id])

  @@index([leaveTypeId])
  @@index([departmentId])
  @@index([positionId])
  @@map("leave_policies")
}

model LeaveBalance {
  id                  String   @id @default(cuid())
  employeeId          String
  leaveTypeId         String
  year                Int
  entitledDays        Int      @default(0)
  usedDays            Int      @default(0)
  pendingDays         Int      @default(0)
  lastAccruedYearMonth Int?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  employee  Employee  @relation(fields: [employeeId], references: [id])
  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id])

  @@unique([employeeId, leaveTypeId, year])
  @@index([leaveTypeId])
  @@map("leave_balances")
}

model LeaveRequest {
  id            String             @id @default(cuid())
  employeeId    String
  leaveTypeId   String
  startDate     DateTime           @db.Date
  endDate       DateTime           @db.Date
  days          Int
  reason        String
  status        LeaveRequestStatus @default(PENDING)
  currentStep   Int                @default(1)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  employee    Employee          @relation(fields: [employeeId], references: [id])
  leaveType   LeaveType         @relation(fields: [leaveTypeId], references: [id])
  approvals   LeaveApproval[]
  attachments LeaveAttachment[]

  @@index([employeeId, status])
  @@index([leaveTypeId])
  @@index([startDate, endDate])
  @@map("leave_requests")
}

model LeaveApproval {
  id                  String              @id @default(cuid())
  requestId           String
  step                Int
  approverEmployeeId  String?
  status              LeaveApprovalStatus @default(PENDING)
  comment             String?
  decidedAt           DateTime?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  request  LeaveRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  approver Employee?    @relation(fields: [approverEmployeeId], references: [id])

  @@unique([requestId, step])
  @@index([approverEmployeeId, status])
  @@map("leave_approvals")
}

model LeaveAttachment {
  id               String   @id @default(cuid())
  requestId        String
  fileName         String
  contentType      String
  sizeBytes        Int
  objectKey        String
  uploadedByUserId String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  request    LeaveRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  uploadedBy User         @relation(fields: [uploadedByUserId], references: [id])

  @@index([requestId])
  @@map("leave_attachments")
}

model Notification {
  id              String                   @id @default(cuid())
  recipientUserId String
  type            String
  title           String
  body            String
  entityType      String
  entityId        String
  readAt          DateTime?
  emailStatus     NotificationEmailStatus  @default(PENDING)
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt

  recipient User @relation(fields: [recipientUserId], references: [id], onDelete: Cascade)

  @@index([recipientUserId, readAt])
  @@index([entityType, entityId])
  @@map("notifications")
}

model EmployeePayrollProfile {
  id                     String     @id @default(cuid())
  employeeId             String     @unique
  ptkpStatus             PtkpStatus
  taxMethod              TaxMethod
  npwp                   String?
  bankName               String
  bankAccountNumber      String
  bankAccountName        String
  bpjsKesehatanEnrolled  Boolean    @default(true)
  bpjsTkEnrolled         Boolean    @default(true)
  createdAt              DateTime   @default(now())
  updatedAt              DateTime   @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id])

  @@map("employee_payroll_profiles")
}

model SalaryComponent {
  id        String              @id @default(cuid())
  code      String              @unique
  name      String
  kind      SalaryComponentKind
  isTaxable Boolean             @default(true)
  isActive  Boolean             @default(true)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  assignments EmployeeSalaryAssignment[]

  @@map("salary_components")
}

model EmployeeSalaryAssignment {
  id            String    @id @default(cuid())
  employeeId    String
  componentId   String
  amountRupiah  String
  effectiveFrom DateTime  @db.Date
  effectiveTo   DateTime? @db.Date
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  employee  Employee        @relation(fields: [employeeId], references: [id])
  component SalaryComponent @relation(fields: [componentId], references: [id])

  @@index([employeeId, effectiveFrom])
  @@index([componentId])
  @@map("employee_salary_assignments")
}

model StatutorySetting {
  id        String   @id @default(cuid())
  key       String   @unique
  payload   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("statutory_settings")
}

model PayrollRun {
  id                String            @id @default(cuid())
  periodType        PayrollPeriodType
  periodStart       DateTime          @db.Date
  periodEnd         DateTime          @db.Date
  status            PayrollRunStatus  @default(PENDING)
  triggeredByUserId String
  errorMessage      String?
  processedCount    Int               @default(0)
  skippedCount      Int               @default(0)
  skipReasons       Json?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  triggeredBy User            @relation(fields: [triggeredByUserId], references: [id])
  payslips    Payslip[]
  exports     PayrollExport[]

  @@index([status])
  @@index([periodStart, periodEnd])
  @@map("payroll_runs")
}

model Payslip {
  id              String   @id @default(cuid())
  payrollRunId    String
  employeeId      String
  grossRupiah     String
  statutoryRupiah String
  netRupiah       String
  lines           String
  pdfObjectKey    String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  run      PayrollRun @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  employee Employee   @relation(fields: [employeeId], references: [id])

  @@unique([payrollRunId, employeeId])
  @@index([employeeId])
  @@map("payslips")
}

model PayrollExport {
  id            String            @id @default(cuid())
  payrollRunId  String
  kind          PayrollExportKind
  objectKey     String
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  run PayrollRun @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)

  @@index([payrollRunId, kind])
  @@map("payroll_exports")
}

model JobPosting {
  id              String           @id @default(cuid())
  slug            String           @unique
  title           String
  description     String
  qualifications  String
  departmentId    String
  positionId      String
  headcount       Int              @default(1)
  maxApplicants   Int
  closesAt        DateTime?
  status          JobPostingStatus @default(DRAFT)
  createdByUserId String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  department Department         @relation(fields: [departmentId], references: [id])
  position   Position           @relation(fields: [positionId], references: [id])
  createdBy  User               @relation(fields: [createdByUserId], references: [id])
  stages     JobPipelineStage[]
  applications Application[]

  @@index([status])
  @@index([departmentId])
  @@index([positionId])
  @@map("job_postings")
}

model JobPipelineStage {
  id           String   @id @default(cuid())
  jobPostingId String
  name         String
  sortOrder    Int
  isTerminal   Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  jobPosting   JobPosting    @relation(fields: [jobPostingId], references: [id], onDelete: Cascade)
  applications Application[]

  @@index([jobPostingId, sortOrder])
  @@map("job_pipeline_stages")
}

model Candidate {
  id         String   @id @default(cuid())
  fullName   String
  email      String   @unique
  phone      String
  nationalId String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  applications Application[]

  @@index([email])
  @@map("candidates")
}

model Application {
  id           String            @id @default(cuid())
  jobPostingId String
  candidateId  String
  stageId      String
  status       ApplicationStatus @default(ACTIVE)
  employeeId   String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  jobPosting  JobPosting              @relation(fields: [jobPostingId], references: [id])
  candidate   Candidate               @relation(fields: [candidateId], references: [id])
  stage       JobPipelineStage        @relation(fields: [stageId], references: [id])
  employee    Employee?               @relation(fields: [employeeId], references: [id])
  notes       ApplicationNote[]
  attachments ApplicationAttachment[]

  @@unique([jobPostingId, candidateId])
  @@index([jobPostingId, status])
  @@index([stageId])
  @@index([candidateId])
  @@map("applications")
}

model ApplicationNote {
  id            String   @id @default(cuid())
  applicationId String
  authorUserId  String
  body          String
  rating        Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  author      User        @relation(fields: [authorUserId], references: [id])

  @@index([applicationId])
  @@map("application_notes")
}

model ApplicationAttachment {
  id               String   @id @default(cuid())
  applicationId    String
  fileName         String
  contentType      String
  sizeBytes        Int
  objectKey        String
  uploadedByUserId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  uploadedBy  User?       @relation(fields: [uploadedByUserId], references: [id])

  @@index([applicationId])
  @@map("application_attachments")
}

model OnboardingTemplate {
  id         String   @id @default(cuid())
  name       String
  positionId String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  position Position?                @relation(fields: [positionId], references: [id])
  items    OnboardingTemplateItem[]
  processes OnboardingProcess[]

  @@index([positionId])
  @@map("onboarding_templates")
}

model OnboardingTemplateItem {
  id           String                 @id @default(cuid())
  templateId   String
  title        String
  description  String
  assigneeKind OnboardingAssigneeKind
  sortOrder    Int
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt

  template OnboardingTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId, sortOrder])
  @@map("onboarding_template_items")
}

model OnboardingProcess {
  id         String                  @id @default(cuid())
  employeeId String                  @unique
  templateId String
  status     OnboardingProcessStatus @default(IN_PROGRESS)
  createdAt  DateTime                @default(now())
  updatedAt  DateTime                @updatedAt

  employee Employee           @relation(fields: [employeeId], references: [id])
  template OnboardingTemplate @relation(fields: [templateId], references: [id])
  tasks    OnboardingTask[]

  @@map("onboarding_processes")
}

model OnboardingTask {
  id                 String                 @id @default(cuid())
  processId          String
  title              String
  description        String
  assigneeKind       OnboardingAssigneeKind
  assigneeEmployeeId String?
  sortOrder          Int
  completedAt        DateTime?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  process  OnboardingProcess @relation(fields: [processId], references: [id], onDelete: Cascade)
  assignee Employee?         @relation("OnboardingAssignee", fields: [assigneeEmployeeId], references: [id])

  @@index([processId])
  @@index([assigneeEmployeeId])
  @@map("onboarding_tasks")
}

model Goal {
  id             String     @id @default(cuid())
  level          GoalLevel
  parentGoalId   String?
  departmentId   String?
  employeeId     String?
  ownerUserId    String
  status         GoalStatus @default(DRAFT)
  title          String
  description    String
  progressPercent Int       @default(0)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  parent     Goal?           @relation("GoalCascade", fields: [parentGoalId], references: [id])
  children   Goal[]          @relation("GoalCascade")
  department Department?     @relation(fields: [departmentId], references: [id])
  employee   Employee?       @relation(fields: [employeeId], references: [id])
  owner      User            @relation(fields: [ownerUserId], references: [id])
  keyResults GoalKeyResult[]

  @@index([parentGoalId])
  @@index([departmentId])
  @@index([employeeId, status])
  @@index([level, status])
  @@map("goals")
}

model GoalKeyResult {
  id           String   @id @default(cuid())
  goalId       String
  title        String
  targetValue  Float
  currentValue Float    @default(0)
  weight       Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  goal Goal @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@index([goalId])
  @@map("goal_key_results")
}

model PerformanceCycle {
  id         String                  @id @default(cuid())
  name       String
  periodType PerformancePeriodType
  startsAt   DateTime                @db.Date
  endsAt     DateTime                @db.Date
  status     PerformanceCycleStatus  @default(DRAFT)
  createdAt  DateTime                @default(now())
  updatedAt  DateTime                @updatedAt

  reviews PerformanceReview[]

  @@index([status])
  @@index([startsAt, endsAt])
  @@map("performance_cycles")
}

model PerformanceReview {
  id             String                      @id @default(cuid())
  cycleId        String
  employeeId     String
  status         PerformanceReviewStatus     @default(PENDING)
  finalScore     Float?
  recommendation PerformanceRecommendation?
  createdAt      DateTime                    @default(now())
  updatedAt      DateTime                    @updatedAt

  cycle   PerformanceCycle              @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  employee Employee                     @relation(fields: [employeeId], references: [id])
  peers    PerformancePeerAssignment[]
  ratings  PerformanceRating[]

  @@unique([cycleId, employeeId])
  @@index([employeeId, status])
  @@index([cycleId, status])
  @@map("performance_reviews")
}

model PerformancePeerAssignment {
  id             String   @id @default(cuid())
  reviewId       String
  peerEmployeeId String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  review PerformanceReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  peer   Employee          @relation(fields: [peerEmployeeId], references: [id])

  @@unique([reviewId, peerEmployeeId])
  @@index([peerEmployeeId])
  @@map("performance_peer_assignments")
}

model PerformanceRating {
  id              String               @id @default(cuid())
  reviewId        String
  raterEmployeeId String
  raterType       PerformanceRaterType
  score           Int
  comment         String
  submittedAt     DateTime
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  review PerformanceReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  rater  Employee          @relation(fields: [raterEmployeeId], references: [id])

  @@unique([reviewId, raterEmployeeId])
  @@index([raterEmployeeId])
  @@map("performance_ratings")
}
